import { useEffect, useState } from "react";
import { api } from "../lib/api";
import type { AgentAccuracy, TickerReport } from "../types/api";
import { num, pct } from "../lib/format";
import { Chip, Empty, Panel } from "../components/ui";

const AGENTS = ["final", "fundamentals", "sentiment", "technicals", "bull", "bear", "judge"] as const;
const HORIZONS = ["1", "5", "20"] as const;

function heat(acc: number | null): string {
  if (acc === null) return "text-faint";
  if (acc >= 0.6) return "text-bull";
  if (acc >= 0.5) return "text-ink";
  if (acc >= 0.4) return "text-amber";
  return "text-bear";
}

function cell(a: AgentAccuracy | undefined): { main: string; sub: string; cls: string } {
  if (!a) return { main: "—", sub: "", cls: "text-faint" };
  if (a.accuracy === null) return { main: "n/a", sub: `n=${a.n_directional}`, cls: "text-faint" };
  return {
    main: `${(a.accuracy * 100).toFixed(0)}%`,
    sub: `${a.n_correct}/${a.n_directional}`,
    cls: heat(a.accuracy),
  };
}

function AccuracyTable({ r }: { r: TickerReport }) {
  return (
    <div className="overflow-x-auto">
      <table className="w-full border-collapse text-[11px]">
        <thead>
          <tr className="border-b border-hairline">
            <th className="px-2 py-1.5 text-left label-micro">agent</th>
            {HORIZONS.map((h) => (
              <th key={h} className="px-2 py-1.5 text-right label-micro">
                h={h}
              </th>
            ))}
            <th className="px-2 py-1.5 text-right label-micro">coverage</th>
          </tr>
        </thead>
        <tbody>
          {AGENTS.map((agent) => {
            const row = r.per_agent_directional[agent];
            const cov = row?.["1"]?.coverage;
            return (
              <tr key={agent} className="border-b border-hairline/50 last:border-0">
                <td className="px-2 py-1.5 text-ink">{agent}</td>
                {HORIZONS.map((h) => {
                  const c = cell(row?.[h]);
                  return (
                    <td key={h} className="px-2 py-1.5 text-right">
                      <div className={`tabular-nums ${c.cls}`}>{c.main}</div>
                      <div className="text-[9px] text-faint tabular-nums">{c.sub}</div>
                    </td>
                  );
                })}
                <td className="px-2 py-1.5 text-right text-dim tabular-nums">
                  {cov === undefined ? "—" : pct(cov, 0)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}

function GapBar({ r }: { r: TickerReport }) {
  const g = r.confidence_gap;
  if (!g || g.n === 0) return <Empty>no debate confidence data</Empty>;
  const scale = Math.max(g.bull_mean, g.bear_mean, 0.01);
  return (
    <div className="space-y-2 p-3">
      {(
        [
          ["bull mean", g.bull_mean, "bg-bull"],
          ["bear mean", g.bear_mean, "bg-bear"],
        ] as const
      ).map(([label, v, cls]) => (
        <div key={label} className="flex items-center gap-2 text-[11px]">
          <span className="w-20 text-dim">{label}</span>
          <div className="h-2.5 flex-1 bg-panel-2">
            <div className={`h-full ${cls}`} style={{ width: `${(v / scale) * 100}%` }} />
          </div>
          <span className="w-10 text-right text-ink tabular-nums">{num(v, 2)}</span>
        </div>
      ))}
      <div className="flex items-center justify-between border-t border-hairline pt-2 text-[11px]">
        <span className="label-micro">symmetry gap |bull−bear|</span>
        <span className={`tabular-nums ${g.abs_gap > 0.3 ? "text-amber" : "text-bull"}`}>
          {num(g.abs_gap, 3)} <span className="text-faint">(n={g.n})</span>
        </span>
      </div>
    </div>
  );
}

function Metrics({ r }: { r: TickerReport }) {
  const items: [string, string][] = [
    ["sharpe", num(r.sharpe, 2)],
    ["sortino", num(r.sortino, 2)],
    ["max dd", r.max_dd === null ? "—" : pct(r.max_dd, 1)],
    ["calmar", num(r.calmar, 2)],
    ["records", String(r.n_records)],
    ["errors", String(r.n_errors)],
  ];
  const sim = r.simulate_stats as Record<string, unknown> | null;
  if (sim) {
    items.push(
      ["hit rate", sim.hit_rate_pct !== undefined ? pct(Number(sim.hit_rate_pct) / 100, 0) : "—"],
      ["return", sim.return_pct !== undefined ? pct(Number(sim.return_pct), 2) : "—"],
      ["trades", `${Number(sim.wins ?? 0) + Number(sim.losses ?? 0)}`],
    );
  }
  return (
    <div className="grid grid-cols-3 gap-2 p-3 sm:grid-cols-5">
      {items.map(([k, v]) => (
        <div key={k} className="border border-hairline bg-panel-2 px-2 py-1.5">
          <div className="label-micro">{k}</div>
          <div className={`text-[13px] tabular-nums ${v === "—" ? "text-faint" : "text-ink"}`}>{v}</div>
        </div>
      ))}
    </div>
  );
}

export default function Analytics() {
  const [tickers, setTickers] = useState<TickerReport[]>([]);
  const [err, setErr] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    api
      .summary()
      .then((s) => setTickers(s.tickers))
      .catch((e: Error) => setErr(e.message))
      .finally(() => setLoading(false));
  }, []);

  return (
    <div className="mx-auto max-w-6xl space-y-3 p-4">
      <div className="flex items-center gap-3">
        <h2 className="text-[12px] tracking-[0.3em] text-ink uppercase">Analytics</h2>
        <Chip tone="data">reports/nasdaq_focus/summary.json</Chip>
      </div>
      {loading && <Empty>loading eval summary…</Empty>}
      {err && <Empty>error: {err}</Empty>}
      {!loading && !err && tickers.length === 0 && <Empty>no eval summary found</Empty>}
      {tickers.map((r) => (
        <div key={r.ticker} className="space-y-3">
          <div className="flex items-baseline gap-3">
            <span className="text-[16px] font-bold text-ink">{r.ticker}</span>
            <span className="text-[11px] text-dim tabular-nums">{r.n_records} records</span>
            <span className="text-[10px] text-faint uppercase">directional accuracy h=1/5/20</span>
          </div>
          <div className="grid gap-3 lg:grid-cols-[1fr_360px]">
            <Panel title={`Per-agent accuracy — ${r.ticker}`}>
              <AccuracyTable r={r} />
            </Panel>
            <div className="space-y-3">
              <Panel title="Debate Symmetry">
                <GapBar r={r} />
              </Panel>
              <Panel title="Risk / Simulation">
                <Metrics r={r} />
              </Panel>
            </div>
          </div>
        </div>
      ))}
    </div>
  );
}
