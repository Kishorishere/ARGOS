# Argos — Multi-Agent Trading Research Desk
# Two Google Cloud projects = two independent free-tier quota pools

# Project A: Fundamentals, Sentiment, Technicals, Bull, Bear (all on gemini-2.5-flash)
# Fundamentals & Sentiment use Google Search grounding (5,000 free searches/month shared)
GEMINI_PROJECT_A_API_KEY=your_project_a_key_here

# Project B: Risk Manager (gemini-2.5-flash) + Portfolio Manager (gemini-2.5-pro)
GEMINI_PROJECT_B_API_KEY=your_project_b_key_here

# Project C (optional): extra fallback quota bucket — router uses it after
# Project A + B are exhausted, then falls through to Groq / OpenRouter.
GEMINI_PROJECT_C_API_KEY=

# ── LLM tuning (all optional) ──────────────────────────────────────────────
# GEMINI_MAX_RETRIES=5           # how many times to retry a 429/5xx from Gemini
# GEMINI_TIMEOUT_S=60            # per-request timeout in seconds

# ── Kronos Forecast Service ────────────────────────────────────────────────
# Set after running the Colab notebook. Cloudflare quick-tunnel URLs are
# EPHEMERAL — they change every time the notebook restarts, so re-paste it
# whenever you re-launch the Colab cell. Leave blank to disable Kronos and
# fall back to indicator-only technicals.
KRONOS_ENDPOINT_URL=
# KRONOS_UNCERTAINTY_SAMPLES=5   # how many samples for Kronos uncertainty bands

# ── Backtest driver ────────────────────────────────────────────────────────
BACKTEST_TICKER=AAPL
BACKTEST_START=2024-01-02
BACKTEST_END=2024-01-31

# ── Debate ─────────────────────────────────────────────────────────────────
MAX_DEBATE_ROUNDS=2               # 1..N; how many bull↔bear rounds before Risk

# ── Paper portfolio ────────────────────────────────────────────────────────
# Path to a JSON portfolio the Risk Manager will see. Empty portfolio is used
# if unset or the file is missing. Example schema in argos/portfolio/state.py.
PAPER_PORTFOLIO_PATH=data/portfolio.json

# ── NEPSE data source ──────────────────────────────────────────────────────
# Base URL of the market-snapshot API (gainers/losers/sectors/index/breadth).
# Historical OHLCV is pulled directly from Merolagani (no config needed).
NEPSE_API_URL=https://nepse.nandisolutions.com

# ── Multi-provider free-tier LLM routing (see ARGOS_FREE_LLM_PROVIDERS.md) ──
# Only Gemini keys are strictly required; the others are used per-agent by
# argos/model_router.py when set (falls back to Gemini otherwise).
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
